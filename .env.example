# =============================================================================
# Exemplo de variáveis de ambiente — NÃO coloque credenciais reais aqui.
# Copie para `.env` (desenvolvimento) e configure na Vercel (produção).
# =============================================================================

# --- Banco de dados PostgreSQL (Neon ou compatível) --------------------------
# Conexão "pooled" (runtime da aplicação serverless). Para o Neon, inclua
# normalmente "-pooler" no host e os parâmetros recomendados pelo provedor.
DATABASE_URL="postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/banco?sslmode=verify-full"
# Conexão direta (usada pelo Prisma CLI para migrações). Opcional em runtime.
DIRECT_URL="postgresql://usuario:senha@host.regiao.aws.neon.tech/banco?sslmode=verify-full"

# --- Aplicação ---------------------------------------------------------------
# URL pública do site (usada em sitemap, Open Graph e links absolutos).
APP_URL="http://localhost:3000"

# --- Sessão / autenticação ---------------------------------------------------
# Segredo para criptografar o cookie de sessão. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48
SESSION_SECRET="troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres"

# --- Armazenamento de imagens (Cloudinary) -----------------------------------
# Sem estas variáveis o upload de imagens fica desabilitado no painel.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="fraternidade-da-luz"

# --- Administrador inicial (apenas para o script de bootstrap) ----------------
# Usadas uma única vez por `npm run admin:create`. NÃO versionar o .env.
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ADMIN_EMAIL="admin@exemplo.org"
INITIAL_ADMIN_PASSWORD="defina-uma-senha-forte"
